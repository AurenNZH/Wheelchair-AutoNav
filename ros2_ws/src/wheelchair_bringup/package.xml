<?xml version="1.0"?>
<package format="3">
  <name>wheelchair_bringup</name>
  <version>0.1.0</version>
  <description>Top-level sensor and navigation launch files for the wheelchair.</description>
  <maintainer email="auren.ng@gmail.com">AurenNZH</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>rslidar_sdk</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>wheelchair_navigation</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

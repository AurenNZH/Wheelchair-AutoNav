<?xml version="1.0"?>
<package format="3">
  <name>wheelchair_obstacle_avoidance</name>
  <version>0.1.0</version>
  <description>Odometry-free local Nav2 planning for shared wheelchair steering.</description>
  <maintainer email="auren.ng@gmail.com">AurenNZH</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>smac_planner</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>wheelchair_msgs</exec_depend>
  <exec_depend>wheelchair_navigation</exec_depend>
  <exec_depend>wheelchair_shared_control</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>

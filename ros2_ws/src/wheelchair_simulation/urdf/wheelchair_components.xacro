<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="caster_arm_depth" value="0.020"/>
  <xacro:property name="caster_arm_thickness" value="0.010"/>
  <xacro:property name="caster_wheel_clearance" value="0.005"/>
  <xacro:property name="caster_crossbar_height" value="0.020"/>

  <xacro:macro
    name="box_inertial"
    params="mass size_x size_y size_z origin_x origin_y origin_z">
    <inertial>
      <origin xyz="${origin_x} ${origin_y} ${origin_z}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (size_y * size_y + size_z * size_z) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * (size_x * size_x + size_z * size_z) / 12.0}"
        iyz="0.0"
        izz="${mass * (size_x * size_x + size_y * size_y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_y_inertial" params="mass radius length">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (3.0 * radius * radius + length * length) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * radius * radius / 2.0}"
        iyz="0.0"
        izz="${mass * (3.0 * radius * radius + length * length) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="drive_wheel" params="name x y z radius width mass">
    <link name="${name}">
      <xacro:cylinder_y_inertial mass="${mass}" radius="${radius}" length="${width}"/>
      <visual name="${name}_visual">
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${width}"/>
        </geometry>
        <material name="tire_grey"/>
      </visual>
      <collision name="${name}_collision">
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${width}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:macro
    name="caster"
    params="prefix swivel_x swivel_y swivel_z trail drop wheel_radius wheel_width fork_mass wheel_mass">
    <link name="${prefix}_caster_fork">
      <xacro:box_inertial
        mass="${fork_mass}"
        size_x="${trail + caster_arm_depth}"
        size_y="${wheel_width + 2.0 * caster_wheel_clearance + 2.0 * caster_arm_thickness}"
        size_z="${drop}"
        origin_x="${-trail / 2.0}"
        origin_y="0.0"
        origin_z="${-drop / 2.0}"/>

      <!-- The U-fork is visual-only; collision is intentionally left to the wheel. -->
      <visual name="${prefix}_caster_crossbar_visual">
        <origin xyz="${-trail / 2.0} 0 ${-caster_crossbar_height / 2.0}"/>
        <geometry>
          <box size="${trail + caster_arm_depth} ${wheel_width + 2.0 * caster_wheel_clearance + 2.0 * caster_arm_thickness} ${caster_crossbar_height}"/>
        </geometry>
        <material name="chassis_black"/>
      </visual>
      <visual name="${prefix}_caster_left_arm_visual">
        <origin xyz="${-trail} ${wheel_width / 2.0 + caster_wheel_clearance + caster_arm_thickness / 2.0} ${-drop / 2.0}"/>
        <geometry>
          <box size="${caster_arm_depth} ${caster_arm_thickness} ${drop}"/>
        </geometry>
        <material name="chassis_black"/>
      </visual>
      <visual name="${prefix}_caster_right_arm_visual">
        <origin xyz="${-trail} ${-(wheel_width / 2.0 + caster_wheel_clearance + caster_arm_thickness / 2.0)} ${-drop / 2.0}"/>
        <geometry>
          <box size="${caster_arm_depth} ${caster_arm_thickness} ${drop}"/>
        </geometry>
        <material name="chassis_black"/>
      </visual>
    </link>
    <joint name="${prefix}_caster_swivel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_caster_fork"/>
      <origin xyz="${swivel_x} ${swivel_y} ${swivel_z}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <link name="${prefix}_caster_wheel">
      <xacro:cylinder_y_inertial mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}"/>
      <visual name="${prefix}_caster_wheel_visual">
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="tire_grey"/>
      </visual>
      <collision name="${prefix}_caster_wheel_collision">
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}_caster_wheel_joint" type="continuous">
      <parent link="${prefix}_caster_fork"/>
      <child link="${prefix}_caster_wheel"/>
      <origin xyz="${-trail} 0 ${-drop}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
</robot>

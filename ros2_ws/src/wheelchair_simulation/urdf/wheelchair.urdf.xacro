<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wheelchair">
  <xacro:include filename="wheelchair_components.xacro"/>

  <!-- Physical bringup may override these measured mount values. -->
  <xacro:arg name="lidar_right_x" default="0.330"/>
  <xacro:arg name="lidar_right_y" default="-0.220"/>
  <xacro:arg name="lidar_right_z" default="0.320"/>
  <xacro:arg name="lidar_right_yaw" default="0.479965544"/>
  <xacro:arg name="lidar_right_pitch" default="0.0"/>
  <xacro:arg name="lidar_right_roll" default="0.0"/>
  <xacro:arg name="lidar_left_x" default="0.330"/>
  <xacro:arg name="lidar_left_y" default="0.220"/>
  <xacro:arg name="lidar_left_z" default="0.320"/>
  <xacro:arg name="lidar_left_yaw" default="-0.479965544"/>
  <xacro:arg name="lidar_left_pitch" default="0.0"/>
  <xacro:arg name="lidar_left_roll" default="0.0"/>

  <!-- Coordinate convention has X forward, Y left, and Z up from the floor. -->
  <xacro:property name="chassis_length" value="0.75"/>
  <xacro:property name="chassis_width" value="0.37"/>
  <xacro:property name="chassis_height" value="0.30"/>
  <xacro:property name="chassis_z" value="0.25"/>

  <xacro:property name="seat_support_length" value="0.60"/>
  <xacro:property name="seat_support_width" value="0.45"/>
  <xacro:property name="seat_support_height" value="0.06"/>
  <xacro:property name="seat_support_z" value="0.43"/>

  <xacro:property name="seat_length" value="0.50"/>
  <xacro:property name="seat_width" value="0.48"/>
  <xacro:property name="seat_height" value="0.12"/>
  <xacro:property name="seat_z" value="0.52"/>

  <!-- Provisional masses keep Gazebo's unconstrained joints well-defined. -->
  <xacro:property name="chair_body_mass" value="5.0"/>
  <xacro:property name="drive_wheel_mass" value="0.75"/>
  <xacro:property name="caster_fork_mass" value="0.20"/>
  <xacro:property name="caster_wheel_mass" value="0.25"/>
  <xacro:property name="occupant_mass" value="75.0"/>

  <xacro:property name="drive_wheel_radius" value="0.165"/>
  <xacro:property name="drive_wheel_width" value="0.070"/>
  <xacro:property name="drive_wheel_y" value="0.225"/>

  <xacro:property name="caster_wheel_radius" value="0.090"/>
  <xacro:property name="caster_wheel_width" value="0.060"/>
  <xacro:property name="caster_swivel_z" value="0.230"/>
  <xacro:property name="caster_drop" value="0.140"/>

  <material name="chassis_black">
    <color rgba="0.06 0.06 0.06 1.0"/>
  </material>
  <material name="support_grey">
    <color rgba="0.18 0.18 0.18 1.0"/>
  </material>
  <material name="seat_black">
    <color rgba="0.03 0.03 0.03 1.0"/>
  </material>
  <material name="tire_grey">
    <color rgba="0.38 0.38 0.34 1.0"/>
  </material>
  <material name="sensor_black">
    <color rgba="0.02 0.02 0.02 1.0"/>
  </material>

  <link name="base_link">
    <xacro:box_inertial
      mass="${chair_body_mass}"
      size_x="${chassis_length}"
      size_y="${chassis_width}"
      size_z="${chassis_height}"
      origin_x="0.0"
      origin_y="0.0"
      origin_z="${chassis_z}"/>

    <visual name="lower_chassis_visual">
      <origin xyz="0 0 ${chassis_z}"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="chassis_black"/>
    </visual>
    <collision name="lower_chassis_collision">
      <origin xyz="0 0 ${chassis_z}"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>

    <visual name="seat_support_visual">
      <origin xyz="0 0 ${seat_support_z}"/>
      <geometry>
        <box size="${seat_support_length} ${seat_support_width} ${seat_support_height}"/>
      </geometry>
      <material name="support_grey"/>
    </visual>
    <collision name="seat_support_collision">
      <origin xyz="0 0 ${seat_support_z}"/>
      <geometry>
        <box size="${seat_support_length} ${seat_support_width} ${seat_support_height}"/>
      </geometry>
    </collision>

    <visual name="seat_cushion_visual">
      <origin xyz="0 0 ${seat_z}"/>
      <geometry>
        <box size="${seat_length} ${seat_width} ${seat_height}"/>
      </geometry>
      <material name="seat_black"/>
    </visual>
    <collision name="seat_cushion_collision">
      <origin xyz="0 0 ${seat_z}"/>
      <geometry>
        <box size="${seat_length} ${seat_width} ${seat_height}"/>
      </geometry>
    </collision>
  </link>

  <xacro:drive_wheel
    name="left_drive_wheel"
    x="0.0"
    y="${drive_wheel_y}"
    z="${drive_wheel_radius}"
    radius="${drive_wheel_radius}"
    width="${drive_wheel_width}"
    mass="${drive_wheel_mass}"/>
  <xacro:drive_wheel
    name="right_drive_wheel"
    x="0.0"
    y="${-drive_wheel_y}"
    z="${drive_wheel_radius}"
    radius="${drive_wheel_radius}"
    width="${drive_wheel_width}"
    mass="${drive_wheel_mass}"/>

  <xacro:caster
    prefix="front_left"
    swivel_x="0.320"
    swivel_y="0.220"
    swivel_z="${caster_swivel_z}"
    trail="0.020"
    drop="${caster_drop}"
    wheel_radius="${caster_wheel_radius}"
    wheel_width="${caster_wheel_width}"
    fork_mass="${caster_fork_mass}"
    wheel_mass="${caster_wheel_mass}"/>
  <xacro:caster
    prefix="front_right"
    swivel_x="0.320"
    swivel_y="-0.220"
    swivel_z="${caster_swivel_z}"
    trail="0.020"
    drop="${caster_drop}"
    wheel_radius="${caster_wheel_radius}"
    wheel_width="${caster_wheel_width}"
    fork_mass="${caster_fork_mass}"
    wheel_mass="${caster_wheel_mass}"/>
  <xacro:caster
    prefix="rear_left"
    swivel_x="-0.375"
    swivel_y="0.160"
    swivel_z="${caster_swivel_z}"
    trail="0.025"
    drop="${caster_drop}"
    wheel_radius="${caster_wheel_radius}"
    wheel_width="${caster_wheel_width}"
    fork_mass="${caster_fork_mass}"
    wheel_mass="${caster_wheel_mass}"/>
  <xacro:caster
    prefix="rear_right"
    swivel_x="-0.375"
    swivel_y="-0.160"
    swivel_z="${caster_swivel_z}"
    trail="0.025"
    drop="${caster_drop}"
    wheel_radius="${caster_wheel_radius}"
    wheel_width="${caster_wheel_width}"
    fork_mass="${caster_fork_mass}"
    wheel_mass="${caster_wheel_mass}"/>

  <!-- Invisible seated payload; location and inertia are provisional. -->
  <link name="occupant_payload">
    <xacro:box_inertial
      mass="${occupant_mass}"
      size_x="0.35"
      size_y="0.45"
      size_z="0.70"
      origin_x="0.0"
      origin_y="0.0"
      origin_z="0.0"/>
  </link>
  <joint name="occupant_payload_joint" type="fixed">
    <parent link="base_link"/>
    <child link="occupant_payload"/>
    <origin xyz="0 0 0.85" rpy="0 0 0"/>
  </joint>

  <!-- Simulated right L2 uses the same frame and mount as physical bringup. -->
  <link name="lidar_right_link">
    <visual name="l2_right_visual">
      <geometry>
        <cylinder radius="0.040" length="0.075"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
  </link>
  <joint name="lidar_right_mount" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_right_link"/>
    <origin
      xyz="$(arg lidar_right_x) $(arg lidar_right_y) $(arg lidar_right_z)"
      rpy="$(arg lidar_right_roll) $(arg lidar_right_pitch) $(arg lidar_right_yaw)"/>
  </joint>

  <!-- The mounted left L2 frame is defined, but no left driver is launched. -->
  <link name="lidar_left_link">
    <visual name="l2_left_visual">
      <geometry>
        <cylinder radius="0.040" length="0.075"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
  </link>
  <joint name="lidar_left_mount" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_left_link"/>
    <origin
      xyz="$(arg lidar_left_x) $(arg lidar_left_y) $(arg lidar_left_z)"
      rpy="$(arg lidar_left_roll) $(arg lidar_left_pitch) $(arg lidar_left_yaw)"/>
  </joint>

  <gazebo reference="lidar_right_link">
    <sensor name="lidar_right_sensor" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10.0</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-${pi}</min_angle>
            <max_angle>${pi}</max_angle>
          </horizontal>
          <vertical>
            <samples>18</samples>
            <resolution>1</resolution>
            <min_angle>-${pi / 4.0}</min_angle>
            <max_angle>${pi / 4.0}</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.45</min>
          <max>100.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="lidar_right_ros" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=/lidar_right/points</remapping>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>lidar_right_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>

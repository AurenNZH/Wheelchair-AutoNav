<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wheelchair">
  <link name="base_link">
    <inertial><mass value="80"/><origin xyz="0 0 0.35"/><inertia ixx="8" ixy="0" ixz="0" iyy="8" iyz="0" izz="8"/></inertial>
    <visual><geometry><box size="0.75 0.65 0.7"/></geometry><origin xyz="0 0 0.35"/></visual>
    <collision><geometry><box size="0.75 0.65 0.4"/></geometry><origin xyz="0 0 0.45"/></collision>
  </link>
  <link name="left_wheel">
    <inertial><mass value="2"/><origin xyz="0 0 0"/><inertia ixx="0.04" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.04"/></inertial>
    <visual><geometry><cylinder radius="0.25" length="0.05"/></geometry><origin rpy="1.5708 0 0"/></visual>
    <collision><geometry><cylinder radius="0.25" length="0.05"/></geometry><origin rpy="1.5708 0 0"/></collision>
  </link>
  <link name="right_wheel">
    <inertial><mass value="2"/><origin xyz="0 0 0"/><inertia ixx="0.04" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.04"/></inertial>
    <visual><geometry><cylinder radius="0.25" length="0.05"/></geometry><origin rpy="1.5708 0 0"/></visual>
    <collision><geometry><cylinder radius="0.25" length="0.05"/></geometry><origin rpy="1.5708 0 0"/></collision>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="left_wheel"/>
    <origin xyz="0 0.375 0.25"/><axis xyz="0 1 0"/>
  </joint>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="right_wheel"/>
    <origin xyz="0 -0.375 0.25"/><axis xyz="0 1 0"/>
  </joint>
  <link name="front_caster">
    <inertial><mass value="1"/><origin xyz="0 0 0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><geometry><sphere radius="0.08"/></geometry></visual>
    <collision><geometry><sphere radius="0.08"/></geometry></collision>
  </link>
  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/><child link="front_caster"/>
    <origin xyz="0.32 0 0.08"/>
  </joint>
  <link name="rslidar"/>
  <joint name="rslidar_mount" type="fixed">
    <parent link="base_link"/><child link="rslidar"/>
    <origin xyz="-0.265 -0.330 0.320" rpy="0 0 -0.7854"/>
  </joint>
  <gazebo reference="rslidar">
    <sensor name="airy_sim" type="ray">
      <always_on>true</always_on><visualize>false</visualize><update_rate>10</update_rate>
      <ray><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal><vertical><samples>32</samples><resolution>1</resolution><min_angle>-0.7854</min_angle><max_angle>0.7854</max_angle></vertical></scan><range><min>0.2</min><max>30.0</max><resolution>0.01</resolution></range></ray>
      <plugin name="airy_pointcloud" filename="libgazebo_ros_ray_sensor.so"><ros><namespace>/sim</namespace><remapping>~/out:=/rslidar_points</remapping></ros><output_type>sensor_msgs/PointCloud2</output_type><frame_name>rslidar</frame_name></plugin>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin name="safe_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/sim</namespace>
        <remapping>cmd_vel:=safe_cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>50</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.75</wheel_separation>
      <wheel_diameter>0.50</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>0.5</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>
</robot>
